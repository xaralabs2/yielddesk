{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/cron/cbn-sync.ts": {
      "maxDuration": 60
    },
    "api/cron/fmdq-sync.ts": {
      "maxDuration": 60
    },
    "api/cron/ngx-sync.ts": {
      "maxDuration": 60
    },
    "api/index.mjs": {
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/api/cron/cbn-sync",
      "destination": "/api/cron/cbn-sync"
    },
    {
      "source": "/api/cron/fmdq-sync",
      "destination": "/api/cron/fmdq-sync"
    },
    {
      "source": "/api/cron/ngx-sync",
      "destination": "/api/cron/ngx-sync"
    },
    {
      "source": "/api/:path*",
      "destination": "/api/index"
    }
  ],
  "crons": [
    {
      "path": "/api/cron/cbn-sync",
      "schedule": "5 * * * *"
    },
    {
      "path": "/api/cron/fmdq-sync",
      "schedule": "15 7-17 * * 1-5"
    },
    {
      "path": "/api/cron/ngx-sync",
      "schedule": "*/30 8-15 * * 1-5"
    }
  ]
}
